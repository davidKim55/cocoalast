    {
     "from": 288,
     "to": 348,
     "text": "그런데 이걸 본 경영진의"
    },
    {
     "from": 348,
     "to": 398,
     "text": "반응이 이랬다고 해요"
    },
    {
     "from": 398,
     "to": 430,
     "text": "귀엽네"
    },
    {
     "from": 430,
     "to": 502,
     "text": "그런데 아무한테도 말하지 마"
    },
    {
     "from": 502,
     "to": 554,
     "text": "필름으로 돈 버는 회사에"
